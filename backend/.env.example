NODE_ENV=development
PORT=3000

# Conexión PostgreSQL (alineado con docker-compose.yml raíz de TT-02)
# Si estas variables no se definen aquí, el backend usa automáticamente POSTGRES_* del .env raíz.
DB_HOST=localhost
DB_PORT=5432
DB_USER=parqueadero_user
DB_PASSWORD=cambiar_esta_clave
DB_NAME=parqueadero
DB_SSL=false

# Motor LPR / OCR (HU-09 - Sprint 2; por defecto simulador local para Plan B)
LPR_MODE=simulator
OCR_SERVICE_URL=http://localhost:8000

# Autenticación JWT (HU-01)
# Clave de firma de los tokens: mínimo 32 caracteres y obligatoria en producción.
# Genere una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria_de_minimo_32_caracteres
# Vigencia del token en segundos (28800 = 8 horas)
JWT_EXPIRES_IN=28800
