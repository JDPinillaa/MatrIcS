NODE_ENV=development
PORT=3000

# Conexión PostgreSQL (alineado con docker-compose.yml raíz de TT-02)
# Si estas variables no se definen aquí, el backend usa automáticamente POSTGRES_* del .env raíz.
DB_HOST=localhost
DB_PORT=5432
DB_USER=parqueadero_user
DB_PASSWORD=cambiar_esta_clave
DB_NAME=parqueadero
DB_SSL=false

# Motor LPR / OCR (HU-09 - Sprint 2; por defecto simulador local para Plan B)
LPR_MODE=simulator
OCR_SERVICE_URL=http://localhost:8000
